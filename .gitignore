# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude settings (keep .claude/ folder tracked for CLAUDE.md, plans, etc.)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# agent skills (installed via `npx skills`, kept local)
.agents/
skills-lock.json

# Scratch codemods and mutation harnesses. peakhour-api carries the same rule
# and records why: two have reached ITS master this way (#1122, #1123). ★The
# sharper risk here is a harness that writes a MUTANT into a source file and
# restores it afterwards — a `git add -A` mid-run commits the mutant, and a
# harness whose own header claimed this rule existed was running in this repo
# with the rule absent.
.tmp-*
